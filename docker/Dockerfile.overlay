# Thin overlay: latest hehua source (GLM escalation + all P0/P1/P2 fixes) on
# top of the v4 image's curated pentest tool layer. No pip install needed —
# hehua's deps (httpx, tsec-benchmark, pwntools, ...) are already in agentx:v4,
# and `python -m hehua` resolves from CWD (/app). Run in local mode over the
# host VPN with --network host.
FROM agentx:v4
WORKDIR /app
# blockchain deps (8/16 new dimension: sign/send eth txs; sandbox has no net)
RUN pip install --no-cache-dir web3 eth-account || true
COPY hehua/ /app/hehua/
COPY scripts/ /app/scripts/
COPY mock/ /app/mock/
# #8 learning loop: prior-run bundle (scripts/learn.py output). Populate learned/
# before building (or leave empty -> no seed). Runner loads it as KB seed.
COPY learned/ /app/learned/
# container-adapted prompt: tells the model the full toolset is on PATH
COPY docker/system.container.md /app/hehua/prompts/system.md
