# ---- LLM API keys (at least one required, OpenAI-compatible) ----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro   # 2nd parallel solver (deep mode)
LLM_PROVIDER=deepseek

# ---- Optional: GLM escalation (stronger model, Anthropic-compatible endpoint) ----
# GLM_API_KEY=
# GLM_MODEL=glm-5.3

# ---- Optional: Qwen (阿里百炼 DashScope, OpenAI-compatible) ----
# ALIYUN_API_KEY=
# ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3-max

# ---- Optional: arbitrary extra models — any OpenAI-compatible endpoint ----
# name|base_url|api_key|model_id, comma-separated
# HEHUA_MODELS=kimi|https://api.kimi.com/v1|sk-xx|kimi-k3,hunyuan|https://api.hunyuan.cloud.tencent.com/v1|key|hunyuan-turbo

# ---- Optional: deep mode (multi-model parallel pentest) ----
# HEHUA_DEEP=deep
# HEHUA_PEERS=2

# ---- Optional: budget per target (minutes) ----
# HEHUA_PENTEST_BUDGET=30
